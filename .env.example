# Copia este archivo como .env y ajusta tus valores. El .env NO se sube a GitHub.

# Instancia de SQL Server (para SQL Express suele ser localhost\SQLEXPRESS)
SQL_SERVER=localhost
SQL_DRIVER=ODBC Driver 18 for SQL Server

SOURCE_DB=WideWorldImporters
DW_DB=DW_Ventas

# Déjalos vacíos para usar autenticación de Windows
SQL_USER=
SQL_PASSWORD=

# Ventana de solapamiento del incremental (horas)
OVERLAP_HOURS=24

# --- API del dashboard ---
# Usuario y clave para entrar al dashboard. Cámbialos. El secreto firma los tokens: pon cualquier texto largo.
API_USER=admin
API_PASSWORD=cambia-esta-clave
API_SECRET=pon-aqui-un-texto-largo-y-aleatorio

# --- Asistente de IA (clave gratis en https://aistudio.google.com) ---
GEMINI_API_KEY=pega-aqui-tu-clave
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_RESPALDO=gemini-3.5-flash-lite

# --- Alertas ---
# Caída mínima de ventas (en %) para que se dispare una alerta
ALERTA_UMBRAL_PCT=15
